rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /custom-prints/{printId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /quotes/{userId}/{quoteId}/{fileName} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if isAdmin() || (request.auth != null
        && request.auth.uid == userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
